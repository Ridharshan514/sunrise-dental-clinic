ayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="1020" y="465" width="330" height="95" as="geometry" /></mxCell><mxCell id="c_dao_impl" value="AppointmentDAOImpl&#10;--&#10;- STORE : ConcurrentHashMap&#10;--&#10;+ findByAppointmentNumber(String) : Appointment&#10;+ isSlotAvailable(int, LocalDate, String) : boolean&#10;+ save(Appointment) : boolean" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="1020" y="595" width="330" height="120" as="geometry" /></mxCell><mxCell id="real_dao" value="" style="endArrow=block;endFill=0;dashed=1;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="c_dao_impl" target="c_dao_iface"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep_dao_db" value="&lt;&lt;uses&gt;&gt;" style="endArrow=open;endSize=10;dashed=1;html=0;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="c_dao_impl" target="c_dbconn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pkg_service" value="" style="shape=folder;tabWidth=260;tabHeight=24;tabPosition=left;html=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="30" y="785" width="1420" height="360" as="geometry" /></mxCell><mxCell id="tab_service" value="com.sunrisedental.service (Business Logic Tier)" style="text;html=0;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="45" y="788" width="290" height="20" as="geometry" /></mxCell><mxCell id="s_auth" value="AuthService&#10;--&#10;- userDAO : UserDAO&#10;--&#10;+ login(username, password) : User&#10;+ checkPermission(User, String) : boolean" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="50" y="835" width="240" height="110" as="geometry" /></mxCell><mxCell id="s_bill" value="BillingService&#10;--&#10;- billDAO : BillDAO&#10;- appointmentDAO : AppointmentDAO&#10;--&#10;+ calculateAndGenerateBill(appNo) : Bill&#10;+ generatePrintableReceipt(Bill) : String" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="320" y="835" width="270" height="120" as="geometry" /></mxCell><mxCell id="s_app" value="AppointmentService&#10;--&#10;- appointmentDAO : AppointmentDAO&#10;- patientDAO : PatientDAO&#10;--&#10;+ registerAppointment(...) : Appointment&#10;+ rescheduleAppointment(...) : Appointment&#10;+ updateStatus(appNo, status) : Appointment&#10;+ cancelAppointment(appNo) : boolean" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="630" y="835" width="290" height="150" as="geometry" /></mxCell><mxCell id="s_rep" value="ReportService&#10;--&#10;+ getDailySchedule(LocalDate) : List&#10;+ getRevenueSummary() : Map&#10;+ getDentistWorkload() : Map" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="950" y="835" width="230" height="110" as="geometry" /></mxCell><mxCell id="s_notif" value="NotificationService&#10;--&#10;- notificationLog : List&#10;--&#10;+ sendAppointmentSms(Appointment, String)&#10;+ sendRescheduleSms(Appointment, String)&#10;+ sendBillEmail(Bill, String)&#10;+ logAudit(String)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="1200" y="835" width="235" height="130" as="geometry" /></mxCell><mxCell id="dep_bill_fac" value="&lt;&lt;uses&gt;&gt;" style="endArrow=open;endSize=10;dashed=1;html=0;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="s_bill" target="c_factory"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="assoc_srv_dao" value="" style="endArrow=open;endSize=10;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="s_app" target="c_dao_iface"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend_box" value="UML 2.5 Architecture &amp; Design Decisions:&#10;1. Generalization (─▷): Patient and Dentist inherit shared demographic state (#personId, #name, #contactNumber) from abstract Person.&#10;2. Security &amp; Auth Decoupling: User is an Authentication Principal (security credential record: username, passwordHash, role).&#10;   Dentist possesses a directed association (0..1 ──&gt; 1) to User, providing staff login credentials without polluting clinical records.&#10;   User.fullName represents audit trail session metadata, while Person.name represents the legal medical record name.&#10;3. Composition (◆─): Appointment exclusively owns Bill lifespan (1 to 0..1). A Bill cannot exist independently of an Appointment.&#10;4. Realization (┄▷): Concrete calculators realize TreatmentCalculator; AppointmentDAOImpl realizes AppointmentDAO.&#10;5. Dependency Inversion (──&gt;): Service layer references the AppointmentDAO Interface rather than the concrete implementation." style="shape=note;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=10;" parent="1" vertex="1"><mxGeometry x="320" y="1005" width="870" height="115" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>