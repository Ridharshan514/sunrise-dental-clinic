<mxfile host="app.diagrams.net" version="21.0.0" type="device"><diagram id="uc_standard" name="1. Use Case Diagram (OMG UML 2.5)"><mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="980" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_main" value="Sunrise Dental Clinic Management System — Use Case Diagram (UML 2.5)" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="350" y="15" width="650" height="30" as="geometry" /></mxCell><mxCell id="sb" value="Sunrise Dental Clinic System" style="shape=swimlane;whiteSpace=wrap;html=0;startSize=28;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#000000;collapsible=0;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="220" y="55" width="840" height="850" as="geometry" /></mxCell><mxCell id="act_rec" value="Receptionist" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;outlineConnect=0;fontStyle=1;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="50" y="320" width="60" height="110" as="geometry" /></mxCell><mxCell id="act_dent" value="Dentist" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;outlineConnect=0;fontStyle=1;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="1150" y="220" width="60" height="110" as="geometry" /></mxCell><mxCell id="act_adm" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;outlineConnect=0;fontStyle=1;fontSize=12;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;font