_rec_book" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_rec" target="uc_book"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_rec_resched" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_rec" target="uc_resched"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_rec_search" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_rec" target="uc_search"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_rec_bill" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_rec" target="uc_bill"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_rec_help" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_rec" target="uc_help"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_dent_status" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_dent" target="uc_status"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_dent_sched" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_dent" target="uc_sched_rep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_dent_work" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_dent" target="uc_work_rep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_adm_work" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_adm" target="uc_work_rep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_adm_rev" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_adm" target="uc_rev_rep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_adm_audit" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_adm" target="uc_audit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note_box" value="UML 2.5 Design Decisions &amp; Methodological Assumptions:&#10;1. Patient Mediation: In accordance with the Sunrise Dental Clinic specification, Patient is an external real-world entity,&#10;   not a direct human user of the clinic terminal. All appointments and payments are staff-mediated via the Receptionist.&#10;2. &lt;&lt;include&gt;&gt; dependencies point Base -&gt; Included (unconditional execution required by the base use case).&#10;3. &lt;&lt;extend&gt;&gt; dependency points Extending -&gt; Base (Prevent Double-Booking conditionally extends Check Slot Availability on collision).&#10;4. Standard OMG Notation: Solid lines indicate Actor-Use Case associations; dashed arrows indicate UML stereotypes." style="shape=note;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=10;" parent="sb" vertex="1"><mxGeometry x="220" y="770" width="840" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="cls_pristine" name="2. Detailed Class Diagram"><mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_main" value="Sunrise Dental Clinic Management System — Detailed 3-Tier Class Diagram (OMG UML 2.5)" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="300" y="15" width="880" height="30" as="geometry" /></mxCell><mxCell id="pkg_mod" value="" style="shape=folder;tabWidth=260;tabHeight=24;tabPosition=left;html=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="30" y="55" width="1420" height="355" as="geometry" /></mxCell><mxCell id="tab_mod" value="com.sunrisedental.model" style="text;html=0;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="45" y="58" width="220" height="20" as="geometry" /></mxCell><mxCell id="c_user" value="User (Auth Principal)&#10;--&#10;- userId : int&#10;- username : String&#10;- passwordHash : String&#10;- fullName : String&#10;- role : String&#10;--&#10;+ getUserId() : int&#10;+ getRole() : String&#10;+ verifyRole(String) : boolean" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="50" y="95" width="185" height="160" as="geometry" /></mxCell><mxCell id="c_person" value="&lt;&lt;abstract&gt;&gt;&#10;Person&#10;--&#10;# personId : int&#10;# name : String&#10;# contactNumber : String&#10;--&#10;+ getName() : String&#10;+ getContactNumber() : String" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="270" y="90" width="190" height="120" as="geometry" /></mxCell><mxCell id="c_patient" value="Patient&#10;--&#10;- address : String&#10;- email : String&#10;--&#10;+ getPatientId() : int&#10;+ getAddress() : String&#10;+ getEmail() : String" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="250" y="250" width="175" height="125" as="geometry" /></mxCell><mxCell id="c_dentist" value="Dentist&#10;--&#10;- specialization : String&#10;- consultationFee : double&#10;- userAccount : User&#10;--&#10;+ getDentistId() : int&#10;+ getSpecialization() : String&#10;+ getConsultationFee() : double&#10;+ getUserAccount() : User" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="445" y="245" width="205" height="140" as="geometry" /></mxCell><mxCell id="c_app" value="Appointment&#10;--&#10;- appointmentId : int&#10;- appointmentNumber : String&#10;- patientId : int&#10;- dentistId : int&#10;- treatmentId : int&#10;- appointmentDate : LocalDate&#10;- appointmentTime : String&#10;- status : String&#10;--&#10;+ getAppointmentNumber() : String&#10;+ setStatus(String) : void&#10;+ reschedule(LocalDate, String) : void" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#000000;collapsible=0;" parent="1" vertex="1"><mxGeometry x="720" y="95" width="240" height="220" as="geometry" /></mxCell><mxCell id="c_treatment" value="Treatment&#10;--&#10;- treatmentId : int&#10;- treatmentName : String&#10;- description : String&#10;- baseCost : double&#10;--&#10;+ getTreatmentId() : int&#10;+ getTreatmentName() : String&#10;+ getBaseCost() : double" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontCol