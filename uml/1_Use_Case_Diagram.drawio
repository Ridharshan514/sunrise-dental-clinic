tus" value="Update Clinical Status&#10;(IN_TREATMENT / COMPLETED)" style="ellipse;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;fontFamily=Helvetica;align=center;verticalAlign=middle;fontStyle=1;" parent="sb" vertex="1"><mxGeometry x="580" y="140" width="210" height="60" as="geometry" /></mxCell><mxCell id="uc_sched_rep" value="View Daily Schedule Report" style="ellipse;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;fontFamily=Helvetica;align=center;verticalAlign=middle;fontStyle=1;" parent="sb" vertex="1"><mxGeometry x="580" y="240" width="210" height="55" as="geometry" /></mxCell><mxCell id="uc_work_rep" value="View Dentist Workload Report" style="ellipse;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;fontFamily=Helvetica;align=center;verticalAlign=middle;fontStyle=1;" parent="sb" vertex="1"><mxGeometry x="580" y="360" width="210" height="55" as="geometry" /></mxCell><mxCell id="uc_rev_rep" value="View Revenue Summary Report" style="ellipse;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;fontFamily=Helvetica;align=center;verticalAlign=middle;fontStyle=1;" parent="sb" vertex="1"><mxGeometry x="580" y="480" width="210" height="55" as="geometry" /></mxCell><mxCell id="uc_audit" value="View Audit &amp; SMS Log" style="ellipse;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;fontFamily=Helvetica;align=center;verticalAlign=middle;fontStyle=1;" parent="sb" vertex="1"><mxGeometry x="580" y="580" width="210" height="50" as="geometry" /></mxCell><mxCell id="rel_login_val" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;endSize=10;dashed=1;html=0;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" parent="sb" edge="1" source="uc_login" target="uc_val_cred"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel_book_val" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;endSize=10;dashed=1;html=0;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" parent="sb" edge="1" source="uc_book" target="uc_val_pat"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel_book_slot" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;endSize=10;dashed=1;html=0;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" parent="sb" edge="1" source="uc_book" target="uc_check_slot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel_resched_slot" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;endSize=10;dashed=1;html=0;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" parent="sb" edge="1" source="uc_resched" target="uc_check_slot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel_ext_double" value="&lt;&lt;extend&gt;&gt;" style="endArrow=open;endSize=10;dashed=1;html=0;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" parent="sb" edge="1" source="uc_double_book" target="uc_check_slot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rel_bill_cost" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;endSize=10;dashed=1;html=0;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" parent="sb" edge="1" source="uc_bill" target="uc_cost_fac"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_rec_login" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_rec" target="uc_login"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_rec_book" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_rec" target="uc_book"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_rec_resched" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_rec" target="uc_resched"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_rec_search" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_rec" target="uc_search"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_rec_bill" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_rec" target="uc_bill"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_rec_help" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_rec" target="uc_help"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_dent_status" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_dent" target="uc_status"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_dent_sched" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_dent" target="uc_sched_rep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_dent_work" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_dent" target="uc_work_rep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_adm_work" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_adm" target="uc_work_rep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_adm_rev" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_adm" target="uc_rev_rep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_adm_audit" value="" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" parent="1" edge="1" source="act_adm" target="uc_audit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note_box" value="UML 2.5 Design Decisions &amp; Methodological Assumptions:&#10;1. Patient Mediation: In accordance with the Sunrise Dental Clinic specification, Patient is an external real-world entity,&#10;   not a direct human user of the clinic terminal. All appointments and payments are staff-mediated via the Receptionist.&#10;2. &lt;&lt;include&gt;&gt; dependencies point Base -&gt; Included (unconditional execution required by the base use case).&#10;3. &lt;&lt;extend&gt;&gt; dependency points Extending -&gt; Base (Prevent Double-Booking conditionally extends Check Slot Availability on collision).&#10;4. Standard OMG Notation: Solid lines indicate Actor-Use Case associations; dashed arrows indicate UML stereotypes." style="shape=note;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=10;" parent="sb" vertex="1"><mxGeometry x="220" y="770" width="840" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>