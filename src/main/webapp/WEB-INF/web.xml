<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Sunrise Dental Clinic Management System</display-name>
    <description>CIS6003 Advanced Programming Web Application</description>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- 1. Authentication Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <!-- 2. Appointment Management Servlet -->
    <servlet>
        <servlet-name>AppointmentServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.AppointmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppointmentServlet</servlet-name>
        <url-pattern>/api/appointments/*</url-pattern>
    </servlet-mapping>

    <!-- 3. Patient Management Servlet -->
    <servlet>
        <servlet-name>PatientServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.PatientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientServlet</servlet-name>
        <url-pattern>/api/patients/*</url-pattern>
    </servlet-mapping>

    <!-- 4. Dentist and Treatment Catalog Servlet -->
    <servlet>
        <servlet-name>DentistServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.DentistServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DentistServlet</servlet-name>
        <url-pattern>/api/dentists/*</url-pattern>
    </servlet-mapping>

    <!-- 5. Billing and Invoicing Servlet -->
    <servlet>
        <servlet-name>BillingServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.BillingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BillingServlet</servlet-name>
        <url-pattern>/api/billing/*</url-pattern>
    </servlet-mapping>

    <!-- 6. Management Decision Reports Servlet -->
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/api/reports/*</url-pattern>
    </servlet-mapping>

    <!-- Session Timeout Configuration (30 Minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <name>SUNRISE_SESSION</name>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
    </session-config>

</web-app>
